{
  "name": "crab-trap-funnel",
  "version": "4.0.0",
  "description": "CF Worker serving 21 domain landing pages with AI bot trap detection — part of the crab-traps project",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev": "wrangler dev",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250201.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}
